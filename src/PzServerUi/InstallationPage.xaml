<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PzServerUi.InstallationPage"
             BackgroundColor="{AppThemeBinding Light=#F4F6F4, Dark=#171B18}">
    <ScrollView>
        <VerticalStackLayout Padding="28,36"
                             Spacing="20"
                             MaximumWidthRequest="800"
                             HorizontalOptions="Fill">
            <VerticalStackLayout Spacing="8">
                <Label Text="НАСТРОЙКА • WINDOWS"
                       FontAttributes="Bold"
                       FontSize="12"
                       TextColor="{AppThemeBinding Light=#355B43, Dark=#9DD4A9}" />
                <Label Text="Установка Dedicated Server"
                       FontAttributes="Bold"
                       FontSize="30"
                       SemanticProperties.HeadingLevel="Level1" />
                <Label Text="Выбери папку с уже установленным сервером Project Zomboid. Панель ничего не скачивает и не запускает."
                       FontSize="15" />
            </VerticalStackLayout>
            <Border Padding="20"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#C8D1C9, Dark=#49564B}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B25}">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Сохранённая папка"
                           FontAttributes="Bold"
                           SemanticProperties.HeadingLevel="Level2" />
                    <Label x:Name="SavedFolderLabel"
                           Text="Папка пока не выбрана."
                           LineBreakMode="CharacterWrap" />
                    <Button x:Name="ChooseFolderButton"
                            Text="Выбрать папку"
                            Clicked="OnChooseFolderClicked"
                            HorizontalOptions="Start" />
                    <Label x:Name="MessageLabel"
                           IsVisible="False"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
