<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:profiles="clr-namespace:PzServerUi.Application;assembly=PzServerUi.Application"
             x:Class="PzServerUi.InstallationPage"
             BackgroundColor="{AppThemeBinding Light=#F4F6F4, Dark=#171B18}">
    <Grid Padding="24,20" RowDefinitions="Auto,Auto,*" RowSpacing="16">
        <VerticalStackLayout Spacing="4">
            <Label Text="ЛОКАЛЬНАЯ ПАНЕЛЬ • WINDOWS"
                   FontAttributes="Bold"
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=#355B43, Dark=#9DD4A9}" />
            <Label Text="Серверы Project Zomboid"
                   FontAttributes="Bold"
                   FontSize="30"
                   SemanticProperties.HeadingLevel="Level1" />
        </VerticalStackLayout>
        <Border Grid.Row="1" Padding="14,10"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#C8D1C9, Dark=#49564B}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B25}">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="14">
                <VerticalStackLayout Spacing="4">
                    <Label Text="Установка Dedicated Server" FontAttributes="Bold" />
                    <Label x:Name="SavedFolderLabel" Text="Папка пока не выбрана." LineBreakMode="CharacterWrap" />
                </VerticalStackLayout>
                <Button Grid.Column="1" x:Name="ChooseFolderButton" Text="Выбрать папку"
                        VerticalOptions="Center" Clicked="OnChooseFolderClicked" />
                <Label Grid.Row="1" Grid.ColumnSpan="2" x:Name="MessageLabel" IsVisible="False"
                       Margin="0,8,0,0" LineBreakMode="WordWrap" />
            </Grid>
        </Border>
        <Grid Grid.Row="2" ColumnDefinitions="2*,3*" ColumnSpacing="12">
            <Border Padding="12"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#C8D1C9, Dark=#49564B}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B25}">
                <Grid RowDefinitions="Auto,Auto,*" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="Профили" FontAttributes="Bold" FontSize="18"
                               VerticalOptions="Center" SemanticProperties.HeadingLevel="Level2" />
                        <Button Grid.Column="1" Text="Обновить" Clicked="OnRefreshProfilesClicked" />
                    </Grid>
                    <Label Grid.Row="1" x:Name="ProfileListMessage" IsVisible="False" LineBreakMode="WordWrap" />
                    <CollectionView Grid.Row="2" x:Name="ProfileList"
                                    SelectionMode="Single" SelectionChanged="OnProfileSelectionChanged">
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="profiles:ServerProfile">
                                <Grid Padding="10,8">
                                    <Label Text="{Binding Name}" LineBreakMode="TailTruncation" />
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>
            </Border>
            <Border Grid.Column="1" Padding="16"
                    StrokeShape="RoundRectangle 12"
                    Stroke="{AppThemeBinding Light=#C8D1C9, Dark=#49564B}"
                    BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#232B25}">
                <ScrollView>
                    <VerticalStackLayout Spacing="10">
                        <Label Text="Выбранный экземпляр" FontAttributes="Bold" FontSize="18"
                               SemanticProperties.HeadingLevel="Level2" />
                        <Label x:Name="ProfileDetailsPlaceholder" Text="Выбери профиль в списке слева." />
                        <VerticalStackLayout x:Name="ProfileDetails" IsVisible="False" Spacing="10">
                            <Label x:Name="ProfileNameLabel" FontAttributes="Bold" FontSize="24"
                                   LineBreakMode="CharacterWrap" />
                            <Label x:Name="SessionStatusLabel" FontAttributes="Bold" LineBreakMode="WordWrap" />
                            <HorizontalStackLayout Spacing="8">
                                <Button x:Name="StartServerButton" Text="Запустить" Clicked="OnStartServerClicked" />
                                <Button x:Name="StopServerButton" Text="Остановить" Clicked="OnStopServerClicked" />
                            </HorizontalStackLayout>
                            <Label x:Name="LaunchMessageLabel" IsVisible="False" LineBreakMode="WordWrap" />
                            <HorizontalStackLayout Spacing="8">
                                <Button x:Name="ShowProfileButton" Text="Профиль" Clicked="OnShowProfileClicked" IsEnabled="False" />
                                <Button x:Name="ShowConsoleButton" Text="Консоль" Clicked="OnShowConsoleClicked" />
                            </HorizontalStackLayout>
                            <VerticalStackLayout x:Name="ProfilePane" Spacing="6">
                                <Label Text="Файл настроек" FontAttributes="Bold" />
                                <Label x:Name="ProfileConfigurationLabel" LineBreakMode="CharacterWrap" />
                                <Label Text="Папка мира" FontAttributes="Bold" />
                                <Label x:Name="ProfileWorldLabel" LineBreakMode="CharacterWrap" />
                            </VerticalStackLayout>
                            <VerticalStackLayout x:Name="ConsolePane" IsVisible="False" Spacing="6">
                                <Editor x:Name="ConsoleOutput" IsReadOnly="True" HeightRequest="280"
                                        FontFamily="Consolas" FontSize="12" Placeholder="Вывод сеанса пока отсутствует."
                                        SemanticProperties.Description="Вывод выбранного сервера" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <Entry x:Name="ConsoleInput" Placeholder="Команда или ответ сервера"
                                           MaxLength="1024" IsPassword="True" IsTextPredictionEnabled="False"
                                           IsSpellCheckEnabled="False" Completed="OnSendConsoleClicked" />
                                    <Button Grid.Column="1" x:Name="SendConsoleButton" Text="Отправить"
                                            Clicked="OnSendConsoleClicked" />
                                </Grid>
                                <HorizontalStackLayout Spacing="4">
                                    <CheckBox x:Name="MaskConsoleInput" IsChecked="True" CheckedChanged="OnMaskConsoleChanged"
                                              SemanticProperties.Description="Скрывать ввод" />
                                    <Label Text="Скрывать ввод (для паролей)" VerticalOptions="Center" />
                                </HorizontalStackLayout>
                                <Label x:Name="ConsoleMessage" IsVisible="False" LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
